{
  "manifest_version": 3,
  "name": "WebTalk TTS",
  "version": "1.0.0",
  "description": "Text-to-Speech browser extension for reading web content aloud",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:8008/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/config.js", "scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": ["scripts/background.js"],
    "service_worker": "scripts/background.js"
  }
}
